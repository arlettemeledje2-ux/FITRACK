# Copie ces noms dans .env.local à la racine du projet.
# Firebase Console > Paramètres du projet > Général > Vos applications > FITRACK Web > Configuration du SDK.
# Recopie uniquement les valeurs entre guillemets de firebaseConfig (sans les guillemets JS).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
